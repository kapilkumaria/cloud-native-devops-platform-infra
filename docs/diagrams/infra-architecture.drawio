        <mxCell id="frontend" value="⚛️  &lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;React + Vite&lt;br&gt;Nginx&lt;br&gt;&lt;font color=&quot;#15803d&quot;&gt;&lt;b&gt;Port: 3000&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=15;shadow=1;align=center;" vertex="1" parent="1">
