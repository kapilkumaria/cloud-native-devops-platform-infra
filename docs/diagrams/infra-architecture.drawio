        <mxCell id="subtitle" value="Terraform + Ansible + Docker Compose on AWS" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=2;fontColor=#2563eb;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="75" width="680" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="developer" value="💻  &lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;Push Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=16;shadow=1;align=center;" vertex="1" parent="1">
