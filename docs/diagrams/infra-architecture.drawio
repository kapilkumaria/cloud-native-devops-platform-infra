        <mxCell id="note" value="ℹ️ Infrastructure is provisioned with Terraform, configured with Ansible, and the application is deployed using Docker Compose on an isolated AWS EC2 instance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontSize=15;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="1">
