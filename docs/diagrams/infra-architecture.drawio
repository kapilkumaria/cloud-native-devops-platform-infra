<mxfile host="app.diagrams.net">
  <diagram name="Infrastructure Architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Cloud-Native DevOps Platform - Infrastructure Architecture" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="25" width="1080" height="50" as="geometry"/>
