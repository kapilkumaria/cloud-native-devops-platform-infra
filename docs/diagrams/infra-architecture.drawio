        </mxCell>

        <mxCell id="github" value="🐙  &lt;b&gt;GitHub Repositories&lt;/b&gt;&lt;br&gt;&lt;br&gt;• cloud-native-devops-platform-app&lt;br&gt;• cloud-native-devops-platform-infra&lt;br&gt;• cloud-native-devops-platform-manifests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=15;shadow=1;align=left;spacingLeft=18;" vertex="1" parent="1">
