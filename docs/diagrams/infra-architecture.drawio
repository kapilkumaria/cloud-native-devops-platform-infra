        <mxCell id="postgres" value="🐘  &lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Database: app&lt;br&gt;User: app&lt;br&gt;&lt;font color=&quot;#6d28d9&quot;&gt;&lt;b&gt;Port: 5432&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontSize=15;shadow=1;align=center;" vertex="1" parent="1">
