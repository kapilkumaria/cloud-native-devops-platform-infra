        <mxCell id="terraform" value="🟣  &lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;Provision Infrastructure&lt;br&gt;&lt;br&gt;✅ VPC&lt;br&gt;✅ Public Subnet&lt;br&gt;✅ Internet Gateway&lt;br&gt;✅ Route Table&lt;br&gt;✅ Security Group&lt;br&gt;✅ EC2 Instance&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6d28d9&quot;&gt;&lt;b&gt;terraform apply&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontSize=15;shadow=1;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="270" height="280" as="geometry"/>
        </mxCell>

