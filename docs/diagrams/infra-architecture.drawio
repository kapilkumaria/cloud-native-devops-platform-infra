        <mxCell id="browser" value="🌐  &lt;b&gt;User / Browser&lt;/b&gt;&lt;br&gt;HTTP Access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=17;shadow=1;align=center;" vertex="1" parent="1">
