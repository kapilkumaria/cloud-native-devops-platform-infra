        </mxCell>

        <mxCell id="aws" value="🟧  &lt;b&gt;AWS Cloud&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=#fff7ed;strokeColor=#f97316;fontSize=18;fontStyle=1;fontColor=#9a3412;align=left;verticalAlign=top;spacingLeft=25;spacingTop=22;" vertex="1" parent="1">
