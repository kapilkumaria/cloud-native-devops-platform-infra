# ==============================================================================
# Project 1 — Cloud-Native DevOps Platform
# Terraform Configuration Example
# ==============================================================================
#
# Copy this file to terraform.tfvars and replace machine/network-specific
# values before running Terraform:
#
#   cp terraform.tfvars.example terraform.tfvars
#

aws_region   = "us-east-1"
instance_type = "t3.medium"

# Existing AWS EC2 key pair name
key_name = "YOUR_EC2_KEY_PAIR_NAME"

# Absolute path to the corresponding private key on the Terraform/Ansible
# control machine
ssh_private_key_path = "/home/YOUR_USER/.ssh/YOUR_KEY.pem"

# Public IPv4 address allowed to SSH to the EC2 instance.
# Use CIDR /32 for a single workstation address.
ssh_allowed_cidr = "YOUR_PUBLIC_IP/32"
